#lang sicp
(#%require (only racket/base with-handlers exn:fail?))
;; SICP §2.2.4: painter : frame -> ordered list of transformed line segments.
;; This is the draw-line command stream, not a GUI approximation of composition.
(define make-vect cons)
(define xcor-vect car)
(define ycor-vect cdr)
(define (add-vect a b) (make-vect (+ (car a) (car b)) (+ (cdr a) (cdr b))))
(define (sub-vect a b) (make-vect (- (car a) (car b)) (- (cdr a) (cdr b))))
(define (scale-vect s v) (make-vect (* s (car v)) (* s (cdr v))))
(define make-frame list)
(define origin-frame car)
(define edge1-frame cadr)
(define edge2-frame caddr)
(define make-segment cons)
(define start-segment car)
(define end-segment cdr)
(define (frame-coord-map frame)
  (lambda (v) (add-vect (origin-frame frame)
                (add-vect (scale-vect (xcor-vect v) (edge1-frame frame))
                          (scale-vect (ycor-vect v) (edge2-frame frame))))))
(define (segments->painter segments)
  (lambda (frame)
    (let ((m (frame-coord-map frame)))
      (map (lambda (s) (make-segment (m (start-segment s)) (m (end-segment s)))) segments))))
(define (transform-painter painter origin corner1 corner2)
  (lambda (frame)
    (let* ((m (frame-coord-map frame)) (o (m origin)))
      (painter (make-frame o (sub-vect (m corner1) o) (sub-vect (m corner2) o))))))
(define (beside p q)
  (let ((left (transform-painter p (make-vect 0 0) (make-vect 1/2 0) (make-vect 0 1)))
        (right (transform-painter q (make-vect 1/2 0) (make-vect 1 0) (make-vect 1/2 1))))
    (lambda (f) (append (left f) (right f)))))
(define (below p q)
  (let ((bottom (transform-painter p (make-vect 0 0) (make-vect 1 0) (make-vect 0 1/2)))
        (top (transform-painter q (make-vect 0 1/2) (make-vect 1 1/2) (make-vect 0 1))))
    (lambda (f) (append (bottom f) (top f)))))
(define (flip-vert p)
  (transform-painter p (make-vect 0 1) (make-vect 1 1) (make-vect 0 0)))
(define (flip-horiz p)
  (transform-painter p (make-vect 1 0) (make-vect 0 0) (make-vect 1 1)))
(define (rotate90 p)
  (transform-painter p (make-vect 1 0) (make-vect 1 1) (make-vect 0 0)))
(define (valid-depth n)
  (if (not (and (integer? n) (exact? n) (>= n 0))) (error "invalid split depth" n)))
(define (up-split p n)
  (valid-depth n)
  (if (= n 0) p
      (let ((smaller (up-split p (- n 1)))) (below p (beside smaller smaller)))))
(define (right-split p n)
  (valid-depth n)
  (if (= n 0) p
      (let ((smaller (right-split p (- n 1)))) (beside p (below smaller smaller)))))
(define (corner-split p n)
  (valid-depth n)
  (if (= n 0) p
      (let ((up (up-split p (- n 1))) (right (right-split p (- n 1)))
            (corner (corner-split p (- n 1))))
        (beside (below p (beside up up)) (below (below right right) corner)))))
(define (square-limit p n)
  (let* ((quarter (corner-split p n)) (half (beside (flip-horiz quarter) quarter)))
    (below (flip-vert half) half)))
(define (polyline points)
  (if (or (null? points) (null? (cdr points))) '()
      (cons (make-segment (car points) (cadr points)) (polyline (cdr points)))))
(define (points coords) (map (lambda (xy) (make-vect (car xy) (cadr xy))) coords))
;; 2.49 a,b,c: exact unit-square geometry.
(define outline (segments->painter (polyline (points '((0 0) (1 0) (1 1) (0 1) (0 0))))))
(define cross (segments->painter (list (make-segment (make-vect 0 0) (make-vect 1 1))
                                      (make-segment (make-vect 0 1) (make-vect 1 0)))))
(define diamond (segments->painter (polyline (points '((1/2 0) (1 1/2) (1/2 1) (0 1/2) (1/2 0))))))
;; 2.49 d: traced outline of Figure 2.10, rationalized coordinates.
;; Five open polylines: limbs/head meet the frame boundary; no frame is drawn.
(define wave-segments
  (append
   (polyline (points '((0 17/20) (3/20 3/5) (3/10 13/20) (2/5 13/20)
                       (7/20 17/20) (2/5 1))))
   (polyline (points '((3/5 1) (13/20 17/20) (3/5 13/20) (3/4 13/20) (1 7/20))))
   (polyline (points '((1 3/20) (3/5 9/20) (3/4 0))))
   (polyline (points '((3/5 0) (1/2 3/10) (2/5 0))))
   (polyline (points '((1/4 0) (7/20 1/2) (3/10 3/5) (3/20 2/5) (0 13/20))))))
(define wave (segments->painter wave-segments))
(define unit-frame (make-frame (make-vect 0 0) (make-vect 1 0) (make-vect 0 1)))
(define (check label actual expected)
  (if (not (equal? actual expected)) (error "check failed" label actual expected)))
(define (self-check)
  (check 'primitives (map (lambda (p) (length (p unit-frame))) (list outline cross diamond wave))
         '(4 2 4 17))
  (check 'empty ((segments->painter '()) unit-frame) '())
  (check 'up-zero ((up-split wave 0) unit-frame) (wave unit-frame))
  (check 'up-count (length ((up-split cross 2) unit-frame)) 14)
  (check 'up-position (car ((up-split cross 1) unit-frame))
         (make-segment (make-vect 0 0) (make-vect 1 1/2)))
  (check 'upper-left (list-ref ((up-split cross 1) unit-frame) 2)
         (make-segment (make-vect 0 1/2) (make-vect 1/2 1)))
  (let ((skew (make-frame (make-vect 2 3) (make-vect 4 1) (make-vect 1 2))))
    (check 'affine-map ((frame-coord-map skew) (make-vect 1/2 1/2)) (make-vect 9/2 9/2))
    (check 'skew-cross (car (cross skew)) (make-segment (make-vect 2 3) (make-vect 7 6))))
  (check 'double-flip ((flip-vert (flip-vert wave)) unit-frame) (wave unit-frame))
  (check 'four-rotations ((rotate90 (rotate90 (rotate90 (rotate90 wave)))) unit-frame)
         (wave unit-frame))
  (check 'corner (length ((corner-split cross 1) unit-frame)) 12)
  (check 'square (length ((square-limit cross 1) unit-frame)) 48)
  (check 'negative-depth
         (with-handlers ((exn:fail? (lambda (e) #t))) (up-split cross -1) #f) #t)
  (display "02.05: all checks passed; wave=17 segments, up-split(X,2)=14") (newline))
(self-check)
