(define good-outranked
  '(rule (outranked-by ?staff ?boss)
         (or (supervisor ?staff ?boss)
             (and (supervisor ?staff ?middle) (outranked-by ?middle ?boss)))))
(define bad-outranked
  '(rule (outranked-by ?staff ?boss)
         (or (supervisor ?staff ?boss)
             (and (outranked-by ?middle ?boss) (supervisor ?staff ?middle)))))
(define (install-statements! system statements)
