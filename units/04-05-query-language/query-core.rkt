#lang sicp
(#%require "../04-01-metacircular/evaluator.rkt" (only racket/base gensym))
(#%provide (all-defined))
;; SICP §4.4.4 adaptation. Query variables stay ?-prefixed symbols;
;; fresh rule variables are uninterned symbols, not object Scheme bindings.
(define (var? x)
  (and (symbol? x)
       (> (string-length (symbol->string x)) 0)
       (char=? (string-ref (symbol->string x) 0) #\?)))
(define (walk term frame)
  (if (var? term)
      (let ((b (assq term frame))) (if b (walk (cdr b) frame) term)) term))
(define (instantiate term frame)
  (let ((value (walk term frame)))
    (if (pair? value)
        (cons (instantiate (car value) frame) (instantiate (cdr value) frame)) value)))
(define (occurs? variable term frame)
  (let ((value (walk term frame)))
    (cond ((eq? variable value) #t)
          ((pair? value) (or (occurs? variable (car value) frame)
                            (occurs? variable (cdr value) frame)))
          (else #f))))
(define (ground? term)
  (cond ((var? term) #f)
        ((pair? term) (and (ground? (car term)) (ground? (cdr term))))
        (else #t)))
(define (pattern-match pattern datum frame)
  (if (eq? frame 'failed) 'failed
      (let ((p (walk pattern frame)))
        (cond ((equal? p datum) frame)
              ((var? p) (cons (cons p datum) frame))
              ((and (pair? p) (pair? datum))
               (pattern-match (cdr p) (cdr datum)
                              (pattern-match (car p) (car datum) frame)))
              (else 'failed)))))
(define (unify left right frame)
  (if (eq? frame 'failed) 'failed
      (let ((a (walk left frame)) (b (walk right frame)))
        (cond ((equal? a b) frame)
              ((var? a) (if (occurs? a b frame) 'failed (cons (cons a b) frame)))
              ((var? b) (if (occurs? b a frame) 'failed (cons (cons b a) frame)))
              ((and (pair? a) (pair? b))
               (unify (cdr a) (cdr b) (unify (car a) (car b) frame)))
              (else 'failed)))))
(define (rename-rule rule)
  (let ((names '()))
    (define (rename term)
      (cond ((var? term)
             (let ((b (assq term names)))
               (if b (cdr b)
                   (let ((fresh (gensym (symbol->string term))))
                     (set! names (cons (cons term fresh) names)) fresh))))
            ((pair? term) (cons (rename (car term)) (rename (cdr term))))
            (else term)))
    (rename rule)))
(define canonical-tag (gensym 'unbound))
(define (canonical-goal query frame)
  (let ((names '()) (next 0))
    (define (normalize term)
      (let ((v (walk term frame)))
        (cond ((var? v)
               (let ((b (assq v names)))
                 (if b (cdr b)
                     (let ((key (list canonical-tag next)))
                       (set! next (+ next 1)) (set! names (cons (cons v key) names)) key))))
              ((pair? v)
               ;; Explicit order makes variable numbering independent of host order.
               (let ((head (normalize (car v)))) (cons head (normalize (cdr v)))))
              (else v))))
    (normalize query)))

(define (stream-car stream) (car stream))
(define (stream-cdr stream) (force (cdr stream)))
(define (singleton value) (cons-stream value '()))
(define (stream-map1 f stream)
  (if (null? stream) '() (cons-stream (f (stream-car stream)) (stream-map1 f (stream-cdr stream)))))
(define (interleave-delayed first delayed-second)
  (if (null? first) (force delayed-second)
      (cons-stream (stream-car first)
                   (interleave-delayed (force delayed-second) (delay (stream-cdr first))))))
(define (append-delayed first delayed-second)
  (if (null? first) (force delayed-second)
      (cons-stream (stream-car first) (append-delayed (stream-cdr first) delayed-second))))
(define (stream-flatmap f stream)
  (if (null? stream) '()
      (interleave-delayed (f (stream-car stream))
                          (delay (stream-flatmap f (stream-cdr stream))))))
(define (stream-take stream n)
  (cond ((or (= n 0) (null? stream)) '())
        ((= n 1) (list (stream-car stream))) ; do not force one answer beyond request
        (else (cons (stream-car stream) (stream-take (stream-cdr stream) (- n 1))))))
(define (list->stream xs)
  (if (null? xs) '() (cons-stream (car xs) (list->stream (cdr xs)))))
(define (match-stream frame) (if (eq? frame 'failed) '() (singleton frame)))
(define host-predicates (list (cons '> >) (cons '< <) (cons '= =) (cons 'equal? equal?)))

(define (make-query-system detect-loops? max-steps)
  (if (not (and (integer? max-steps) (> max-steps 0))) (error "Positive query budget required"))
  (let ((assertions '()) (rules '()))
    (define (add! statement)
      (if (not (pair? statement)) (error "Expected relational statement" statement))
      (if (tagged? statement 'rule)
          (begin
            (if (not (and (or (= (length statement) 2) (= (length statement) 3))
                          (pair? (cadr statement)))) (error "Bad rule" statement))
            (let ((old-rules rules)) (set! rules (cons-stream statement old-rules))))
          (begin
            (if (not (ground? statement)) (error "Assertion must be ground" statement))
            (let ((old-assertions assertions))
              (set! assertions (cons-stream statement old-assertions)))))
      'ok)
    (define (run-query query)
      ;; Each result stream owns its own budget and captures a DB snapshot.
      (let ((remaining max-steps) (facts assertions) (clauses rules))
        (define (tick!)
          (set! remaining (- remaining 1))
          (if (< remaining 0) (error "Query step budget exhausted; not logical failure")))
        (define (conjoin queries frames history)
          (if (null? queries) frames
              (conjoin (cdr queries) (qeval (car queries) frames history) history)))
        (define (disjoin queries frames history)
          (if (null? queries) '()
              (interleave-delayed (qeval (car queries) frames history)
                                  (delay (disjoin (cdr queries) frames history)))))
        (define (simple query frame history)
          (tick!)
          (let ((key (canonical-goal query frame)))
            ;; ponytail: ancestor-variant pruning is incomplete; tabling for positive recursion.
            (if (and detect-loops? (member key history)) '()
                (append-delayed
                 (stream-flatmap (lambda (fact) (match-stream (pattern-match query fact frame))) facts)
                 (delay
                   (stream-flatmap
                    (lambda (rule)
                      (let* ((fresh (rename-rule rule)) (extended (unify query (cadr fresh) frame)))
                        (if (eq? extended 'failed) '()
                            (qeval (if (null? (cddr fresh)) '(always-true) (caddr fresh))
                                   (singleton extended) (cons key history))))) clauses))))))
        (define (qeval q frames history)
          (if (not (pair? q)) (error "Expected query expression" q))
          (cond ((tagged? q 'and) (conjoin (cdr q) frames history))
                ((tagged? q 'or) (disjoin (cdr q) frames history))
                ((tagged? q 'always-true) frames)
                ((tagged? q 'not)
                 (if (not (= (length q) 2)) (error "not takes one query" q))
                 (stream-flatmap
                  (lambda (frame)
                    (if (null? (qeval (cadr q) (singleton frame) history)) (singleton frame) '())) frames))
                ((tagged? q 'lisp-value)
                 (stream-flatmap
                  (lambda (frame)
                    (let* ((call (instantiate (cdr q) frame)) (p (assq (car call) host-predicates)))
                      (if (not (ground? call)) (error "Unbound lisp-value argument" call))
                      (if (not p) (error "Predicate not permitted" (car call)))
                      (if (apply (cdr p) (cdr call)) (singleton frame) '()))) frames))
                (else (stream-flatmap (lambda (frame) (simple q frame history)) frames))))
        (stream-map1 (lambda (frame) (instantiate query frame)) (qeval query (singleton '()) '()))))
    (lambda (message value)
      (cond ((eq? message 'assert!) (add! value))
            ((eq? message 'query) (run-query value))
            (else (error "Unknown query request" message))))))
